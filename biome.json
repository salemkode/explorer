{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/.nuxt",
			"!!**/.output",
			"!!**/.build",
			"!!src/graphql",
			"!!src/public",
			"!!src/assets/icons",
			"!!src/assets/images",
			"!src/assets/bcmr-v2.schema.json",
			"!schema/chaingraph.graphql"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": false
		}
	}
}
