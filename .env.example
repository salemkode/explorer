# Chaingraph GraphQL endpoints (read at BUILD time — the SPA bundles them).
# The legacy names CHAINGRAPH_HTTP / CHAINGRAPH_WS are also accepted.
VITE_CHAINGRAPH_HTTP=https://gql.chaingraph.af/v1/graphql
VITE_CHAINGRAPH_WS=wss://gql.chaingraph.af/v1/graphql

# Feature flags
VITE_FEATURE_CONVERTER_ALPHA=true
